# Google Gemini API Key (Get free tier key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model name: gemini-2.0-flash (default) or gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# Official queue access code (minimum 8 characters)
OFFICIAL_ACCESS_CODE=ChangeThisSecretKey123!

# Port for local and container runtime
PORT=8000
